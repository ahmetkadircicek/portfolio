rules_version = '2';

// The portfolio only writes contact messages. Nobody can read, change or
// delete them from the client; read them in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt'])
        && validString(request.resource.data.name, 100)
        && validString(request.resource.data.email, 200)
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && validString(request.resource.data.subject, 150)
        && validString(request.resource.data.message, 5000)
        && request.resource.data.message.size() >= 10
        && request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }

  function validString(value, maxLength) {
    return value is string && value.size() > 0 && value.size() <= maxLength;
  }
}
